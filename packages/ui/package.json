{
  "name": "@barso/ui",
  "version": "0.7.0",
  "description": "Barso UI",
  "license": "MIT",
  "type": "module",
  "types": "./src/index.d.ts",
  "exports": {
    ".": {
      "types": "./src/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    },
    "./document": {
      "types": "./src/_document.d.ts",
      "import": "./dist/_document.js",
      "require": "./dist/_document.cjs"
    },
    "./markdown": {
      "types": "./src/Markdown/index.d.ts",
      "import": "./dist/markdown.js",
      "require": "./dist/markdown.cjs"
    },
    "./primer": {
      "types": "./src/primer-react.d.ts",
      "import": "./dist/primer.js",
      "require": "./dist/primer.cjs"
    },
    "./css": "./dist/ui.css"
  },
  "files": [
    "dist",
    "src",
    "!src/**/*.test.*"
  ],
  "scripts": {
    "dev": "vite build --watch",
    "build": "vite build",
    "test": "tn test",
    "test:run": "tn test run",
    "lint": "eslint . && prettier --check .",
    "format": "eslint --fix . && prettier --write .",
    "prepublishOnly": "npm run build"
  },
  "dependencies": {
    "@bytemd/plugin-breaks": "^1.22.0",
    "@bytemd/plugin-gemoji": "^1.22.0",
    "@bytemd/plugin-gfm": "^1.22.0",
    "@bytemd/plugin-highlight-ssr": "^1.22.0",
    "@bytemd/plugin-math": "^1.22.0",
    "@bytemd/plugin-mermaid": "^1.22.0",
    "@bytemd/react": "^1.22.0",
    "@primer/octicons-react": "^19.15.2",
    "@primer/react": "^37.24.0",
    "rehype-external-links": "^3.0.0",
    "rehype-slug": "^6.0.0",
    "styled-components": "^5.3.11"
  },
  "devDependencies": {
    "next": "16.2.10",
    "react": "19.2.7",
    "react-dom": "19.2.7"
  },
  "peerDependencies": {
    "next": ">=15.2.2",
    "react": ">=18.2.0",
    "react-dom": ">=18.2.0"
  },
  "author": "aprendendofelipe",
  "repository": {
    "type": "git",
    "url": "https://github.com/aprendendofelipe/react-stack",
    "directory": "packages/ui"
  },
  "keywords": [
    "barso",
    "ui"
  ],
  "publishConfig": {
    "access": "public"
  }
}
