{
  "name": "react-stack",
  "version": "0.0.0",
  "private": true,
  "license": "MIT",
  "type": "module",
  "scripts": {
    "dev": "npx lerna run dev --parallel",
    "build": "npm run build:types && npm run build --workspace packages/ui",
    "build:types": "find packages -name '*.d.ts' -o -name '*.d.ts.map' | xargs rm -f; tsc -p tsconfig.build.json",
    "build:examples:form": "npm run build && npm run build --workspace examples/form",
    "start:examples:form": "npm run start --workspace examples/form",
    "build:examples:markdown": "npm run build && npm run build --workspace examples/markdown",
    "start:examples:markdown": "npm run start --workspace examples/markdown",
    "test": "barso test",
    "test:run": "barso test run",
    "coverage": "barso test --coverage",
    "lint": "eslint . --max-warnings 0 && prettier --check .",
    "format": "eslint --fix . && prettier --write .",
    "commit": "cz",
    "prepare": "npm run build:types && husky",
    "pre-commit": "lint-staged"
  },
  "config": {
    "commitizen": {
      "path": "cz-conventional-changelog"
    }
  },
  "devDependencies": {
    "@commitlint/cli": "20.5.0",
    "@commitlint/config-conventional": "20.5.0",
    "@testing-library/dom": "10.4.1",
    "@testing-library/jest-dom": "6.9.1",
    "@testing-library/react": "16.3.2",
    "@testing-library/user-event": "14.6.1",
    "barso": "0.7.0",
    "commitizen": "4.3.1",
    "cz-conventional-changelog": "3.3.0",
    "husky": "9.1.7",
    "lerna": "9.0.7",
    "lint-staged": "16.4.0",
    "rollup-plugin-preserve-directives": "0.4.0"
  },
  "repository": "aprendendofelipe/react-stack",
  "workspaces": [
    "examples/*",
    "packages/*"
  ]
}
