{
  "compilerOptions": {
    "target": "es2020",
    "allowJs": true,
    "checkJs": false,
    "noEmit": true,
    "module": "esnext",
    "moduleResolution": "bundler",
    "types": ["vitest/globals", "@testing-library/jest-dom"],
    "skipLibCheck": true,
    "paths": {
      "packages/*": ["./packages/*"]
    }
  },
  "include": ["packages/**/*", "tests/**/*"],
  "exclude": ["node_modules", "worktrees", ".worktrees", "**/dist", "**/*.d.ts", "**/*.d.ts.map"]
}
